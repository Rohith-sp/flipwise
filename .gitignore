# Data and outputs are never committed (CLAUDE.md, PRD §13.1)
# Everything under data/ except the docs and manifests (PRD §17.1, v0.8): data unzipped into any
# other folder must not be committable by `git add .`.
data/*
!data/README.md
!data/manifests/
results/
# Generated by scripts/build_graph.py; free to rebuild, and rewritten whole on each build.
graphify-out/

# Python / tooling
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
*.egg-info/
dist/
build/

# Secrets
.env
*.pem
.aws/
